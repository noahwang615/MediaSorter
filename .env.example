# Host paths mounted into the mediasorter container.
# Copy to .env and edit, or run install.sh|install.bat to generate it interactively.

MEDIA_SRC=/absolute/path/to/mediadump
PHOTO_DEST=/absolute/path/to/photos
VIDEO_DEST=/absolute/path/to/videos

# MediaSort interval
RUN_INTERVAL_SECONDS=3600

# Proof generation interval
PROOF_INTERVAL_SECONDS=86400

# Proof enable flag (set to "proof" to enable the proof service, leave blank to disable) (Initial install should handle this logic)
COMPOSE_PROFILE=